{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryRecordPolicy",
  "type": "object",
  "required": [
    "namespace",
    "owner_agent",
    "kind",
    "content",
    "visibility",
    "importance"
  ],
  "properties": {
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "owner_agent": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "conversation",
        "preference",
        "fact",
        "task_state",
        "tool_observation",
        "policy"
      ]
    },
    "content": {
      "type": "string",
      "minLength": 1
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared",
        "public"
      ]
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "importance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "metadata": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
