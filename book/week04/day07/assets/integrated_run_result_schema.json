{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IntegratedRunResult",
  "type": "object",
  "required": [
    "status",
    "summary",
    "outputs",
    "blocked_actions",
    "memory_used",
    "trace"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string"
    },
    "outputs": {
      "type": "object"
    },
    "blocked_actions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "memory_used": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trace": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
