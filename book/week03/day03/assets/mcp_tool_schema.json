{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP Tool Definition Example",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "read",
        "write",
        "sensitive"
      ]
    },
    "inputSchema": {
      "type": "object",
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ]
    }
  },
  "required": [
    "name",
    "description",
    "risk_level",
    "inputSchema"
  ],
  "additionalProperties": false
}
