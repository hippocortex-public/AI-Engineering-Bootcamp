{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production AI Architecture Blueprint",
  "type": "object",
  "required": [
    "name",
    "components",
    "controls",
    "risks"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "components": {
      "type": "array",
      "minItems": 8,
      "items": {
        "type": "object",
        "required": [
          "name",
          "kind",
          "critical"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "critical": {
            "type": "boolean"
          },
          "responsibilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "controls": {
      "type": "array"
    },
    "risks": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
